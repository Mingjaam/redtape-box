{
  "name": "redtape-box",
  "productName": "Red Tape",
  "version": "0.1.0",
  "description": "행정 서류(red tape)를 빨간 테이프로 봉인한 상자에 맡기세요 — 양식과 증빙 파일을 넣으면 내 PC의 Claude Code가 서류를 채워 돌려주는 바탕화면 앱. (비공식 오픈소스)",
  "main": "main.js",
  "author": "Mingjaam",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "shot": "electron . --shot",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "postinstall": "node scripts/vendor.js",
    "check": "node -e \"for (const f of ['main.js','preload.js','src/claude-runner.js','src/config.js','src/job.js']) require('child_process').execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"",
    "site": "node scripts/build-site.js"
  },
  "build": {
    "appId": "io.github.mingjaam.redtape",
    "productName": "Red Tape",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "assets/**",
      "LICENSE"
    ],
    "publish": null,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RedTape-Setup.${ext}"
    },
    "portable": {
      "artifactName": "RedTape-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "RedTape-mac.${ext}",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "작업 상자(문서/RedTape)에 넣은 파일의 사본과 결과물을 저장합니다.",
        "NSDesktopFolderUsageDescription": "바탕화면에서 끌어다 놓은 파일을 상자에 담습니다.",
        "NSDownloadsFolderUsageDescription": "다운로드 폴더에서 끌어다 놓은 파일을 상자에 담습니다."
      }
    },
    "dmg": {
      "title": "Red Tape"
    }
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "@fontsource/nanum-gothic-coding": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "three": "^0.187.0"
  },
  "homepage": "https://mingjaam.github.io/redtape-box/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mingjaam/redtape-box.git"
  },
  "bugs": {
    "url": "https://github.com/Mingjaam/redtape-box/issues"
  },
  "keywords": [
    "red-tape",
    "paperwork",
    "claude-code",
    "electron",
    "desktop",
    "three.js",
    "korean"
  ]
}
